# Multi-stage build: compile Rust for linux/arm64, then create runtime image.
# Used for local development builds when cross-compilation tools aren't available.
FROM --platform=linux/arm64 rust:trixie@sha256:8a4e90c7946b74626488b1446f712c0fe0ed1a596cbd3d871684bc9c5433ae07 AS builder

# Install build dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy all source files including tacplus-generated crates.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY target/generated-sources/model ./target/generated-sources/model

# Remove any pre-compiled artifacts that are wrong architecture.
RUN find target/generated-sources/model/target -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

# Copy the pre-built SPA into dist/ for RustEmbed to embed at compile time.
COPY dist ./dist

# Build the release binary.
RUN cargo build --release

# ---- Runtime image ----
FROM --platform=linux/arm64 debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Jody Scott <jody@thescottsweb.com>" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="tacplus.dev" \
      org.opencontainers.image.title="Gateway" \
      org.opencontainers.image.description="The edge gateway of a tacplus fleet"

COPY --from=ghcr.io/grpc-ecosystem/grpc-health-probe:v0.4.60@sha256:2d433b978644e40eb2b2887dbd0af3a19e470514a2176a97cad1971f13bdb171 /ko-app/grpc-health-probe /usr/local/bin/grpc_health_probe
RUN chmod +x /usr/local/bin/grpc_health_probe
COPY --from=builder /build/target/release/gateway /usr/local/bin/gateway
RUN chmod +x /usr/local/bin/gateway

# Customer web app, served on the hostnames gateway Config.web_bundles maps to
# /opt/tacplus/web.
COPY web-dist/ /opt/tacplus/web/

ENTRYPOINT ["gateway"]
